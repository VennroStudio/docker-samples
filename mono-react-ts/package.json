{
  "name": "mono-react-ts-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:admin": "turbo run build --filter=@mono/admin",
    "build:web": "turbo run build --filter=@mono/web",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:exports": "node scripts/check-package-exports.mjs",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "dev:admin": "turbo run dev --filter=@mono/admin",
    "dev:web": "turbo run dev --filter=@mono/web",
    "lint": "turbo run lint && npm run check:exports",
    "preview:admin": "npm run preview --workspace=@mono/admin",
    "preview:web": "npm run preview --workspace=@mono/web",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.6.0",
    "@types/node": "^24.13.2",
    "oxlint": "^1.69.0",
    "steiger": "^0.5.13",
    "turbo": "^2.10.4",
    "typescript": "~6.0.2"
  }
}
